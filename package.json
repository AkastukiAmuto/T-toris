{
  "name": "t-toris",
  "version": "1.4.0",
  "githubRepo": "AkastukiAmuto/T-toris",
  "description": "Desktop Tetris App with Theme Switching, BGM/SE, Hold, Ghost, and Particle Effects",
  "main": "dist/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "tsc -p tsconfig.renderer.json",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "dist": "npm run build && node scripts/build-dist.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "typescript": "^5.6.0"
  }
}
